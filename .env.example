# Development values. Copy to .env and replace every CHANGE_ME with throwaway values.
# Never real secrets: .env is ignored by git and stays on this machine.

# PostgreSQL superuser of the development container
POSTGRES_PASSWORD=CHANGE_ME
# The two application roles (decision 0002), created by docker/dev/postgres-init
ZONEDOSE_APP_PASSWORD=CHANGE_ME
ZONEDOSE_MIGRATOR_PASSWORD=CHANGE_ME
# Local super user that Orchard creates in each tenant at setup (migrate step)
# (at least 6 characters, with a digit, an upper case letter and a symbol)
ZONEDOSE_SETUP_ADMIN_PASSWORD=CHANGE_ME

# Google sign-in: the OAuth client for development (docs/google-oauth.md).
# Left empty, /api/auth/google/login answers /login?error=unavailable.
ZONEDOSE_GOOGLE_CLIENT_ID=
ZONEDOSE_GOOGLE_CLIENT_SECRET=
# The Google account created with this verified email is an active administrator
# (only when the account is created). Use a dedicated address, not a personal one.
ZONEDOSE_ADMIN_EMAIL=

# Hostnames per tenant. Development defaults are in src/Zonedose.Web/appsettings.json
# (platform.localhost, localhost, admin.localhost); set these only to change them.
# ZONEDOSE_HOST_ZONEDOSE=
# ZONEDOSE_ADMIN_HOST_ZONEDOSE=
