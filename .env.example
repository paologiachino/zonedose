# Development values. Copy to .env and replace every CHANGE_ME with throwaway values.
# Never real secrets: .env is ignored by git and stays on this machine.

# PostgreSQL superuser of the development container
POSTGRES_PASSWORD=CHANGE_ME
# The two application roles (decision 0002), created by docker/dev/postgres-init
ZONEDOSE_APP_PASSWORD=CHANGE_ME
ZONEDOSE_MIGRATOR_PASSWORD=CHANGE_ME
# Local super user that Orchard creates in each tenant at setup
# (at least 6 characters, with a digit, an upper case letter and a symbol)
ZONEDOSE_SETUP_ADMIN_PASSWORD=CHANGE_ME
