<Project>
  <!--
    Central package management: every version lives here.
    Transitive pinning lets us raise a package that Orchard Core brings in when
    its version has a known vulnerability; NuGet audit (Directory.Build.props)
    fails the build if one is left.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <OrchardCoreVersion>3.0.1</OrchardCoreVersion>
  </PropertyGroup>

  <ItemGroup Label="Orchard Core">
    <PackageVersion Include="OrchardCore.Application.Cms.Targets" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Module.Targets" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Admin.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Data.Abstractions" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Users.Core" Version="$(OrchardCoreVersion)" />
    <PackageVersion Include="OrchardCore.Users.Abstractions" Version="$(OrchardCoreVersion)" />
  </ItemGroup>

  <ItemGroup Label="Pinned transitive packages (security fixes over Orchard Core 3.0.1)">
    <!-- GHSA-v76p-62qx-wwq2, GHSA-j3p4-wp97-rph4 and others: fixed in 3.2.0 -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.2.0" />
    <!-- GHSA-464h-4j8h-q5mf: Orchard references a 9.1 beta; first stable fix is 9.0.967 -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <!-- GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7: fixed in 10.0.13 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- GHSA-r955-8q5j-3h83, GHSA-23rf-6693-g89p and others: fixed in 10.0.13 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- GHSA-473q-m89c-ghf8: fixed in 2.6.1 -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <!-- GHSA-pgww-w46g-26qg: fixed in 1.5.0 -->
    <PackageVersion Include="AngleSharp" Version="1.10.5" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>
</Project>
