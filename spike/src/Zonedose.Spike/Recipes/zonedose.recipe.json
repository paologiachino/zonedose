{
  "name": "Zonedose",
  "displayName": "Zonedose (spike)",
  "description": "Phase 0 spike tenant: users, Google sign-in, roles and the spike module.",
  "author": "Zonedose",
  "website": "",
  "version": "0.0.1",
  "issetuprecipe": true,
  "categories": [
    "spike"
  ],
  "tags": [],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Settings",
        "OrchardCore.Admin",
        "OrchardCore.Themes",
        "TheAdmin",
        "SafeMode",
        "OrchardCore.Users",
        "OrchardCore.Users.ExternalAuthentication",
        "OrchardCore.Roles",
        "OrchardCore.Google.GoogleAuthentication",
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.ContentFields",
        "OrchardCore.Title",
        "OrchardCore.Html",
        "OrchardCore.Navigation",
        "OrchardCore.Deployment",
        "OrchardCore.Media",
        "OrchardCore.Markdown",
        "OrchardCore.Lists",
        "Zonedose.Spike"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "SafeMode"
    },
    {
      "name": "settings",
      "ExternalRegistrationSettings": {
        "DisableNewRegistrations": false,
        "NoPassword": true,
        "NoUsername": true,
        "NoEmail": true
      },
      "ExternalLoginSettings": {
        "UseExternalProviderIfOnlyOneDefined": false
      }
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "Article",
          "DisplayName": "Article",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Draftable": true,
              "Versionable": true,
              "Securable": true,
              "ThumbnailPath": "~/OrchardCore.ContentTypes/placeholder.png"
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "Article",
              "Name": "Article",
              "Settings": {}
            },
            {
              "PartName": "CommonPart",
              "Name": "CommonPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                }
              }
            },
            {
              "PartName": "HtmlBodyPart",
              "Name": "HtmlBodyPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                }
              }
            },
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "3"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": []
    }
  ]
}
